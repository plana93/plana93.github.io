e baseW: 28 + rnd(s) * 52, baseH: 28 + rnd(s + 1) * 52, // size oscillation ampW: 8 + rnd(s + 7) * 22, ampH: 8 + rnd(s + 8) * 22, freqW: 0.18 + rnd(s + 9) * 0.55, // Hz freqH: 0.15 + rnd(s + 10) * 0.60, phaseW: rnd(s + 11) * Math.PI * 2, phaseH: rnd(s + 12) * Math.PI * 2, // filter cycling filterBase: i % FILTERS.length, filterNext: (i + 1) % FILTERS.length, filterFreq: 0.04 + rnd(s + 13) * 0.10, // Hz filterPhase: rnd(s + 14) * Math.PI * 2, alpha: 0.65 + rnd(s + 4) * 0.30, // bezier control-point: base offset + slow drift cpOxBase: (rnd(s + 5) - 0.5) * 260, cpOyBase: (rnd(s + 6) - 0.5) * 260, cpAmpX: 20 + rnd(s + 15) * 80, // vibration amplitude px cpAmpY: 20 + rnd(s + 16) * 80, cpFreqX: 0.10 + rnd(s + 17) * 0.35, cpFreqY: 0.08 + rnd(s + 18) * 0.38, cpPhaseX: rnd(s + 19) * Math.PI * 2, cpPhaseY: rnd(s + 20) * Math.PI * 2, }); } } function setup() { W = img.offsetWidth; H = img.offsetHeight; if (!W || !H) { setTimeout(setup, 80); return; } canvas.width = W + PAD * 2; canvas.height = H + PAD * 2; Object.assign(canvas.style, { position: 'absolute', top: -PAD + 'px', left: -PAD + 'px', width: (W + PAD * 2) + 'px', height: (H + PAD * 2) + 'px', pointerEvents: 'none', zIndex: '5', }); buildBoxes(W, H); if (raf) cancelAnimationFrame(raf); loop(); } function loop(ts) { var t = ((ts || performance.now()) - t0) * 0.001; // seconds ctx.clearRect(0, 0, canvas.width, canvas.height); boxes.forEach(function (b) { // Animated size var bw = b.baseW + b.ampW * Math.sin(Math.PI * 2 * b.freqW * t + b.phaseW); var bh = b.baseH + b.ampH * Math.sin(Math.PI * 2 * b.freqH * t + b.phaseH); bw = Math.max(18, bw); bh = Math.max(18, bh); // Animated position — slow drift, clamped inside photo var driftX = b.posAmpX * Math.sin(Math.PI * 2 * b.posFreqX * t + b.posPhaseX); var driftY = b.posAmpY * Math.sin(Math.PI * 2 * b.posFreqY * t + b.posPhaseY); var bx = Math.max(0, Math.min(W - bw, b.nx * (W - bw) + driftX)); var by = Math.max(0, Math.min(H - bh, b.ny * (H - bh) + driftY)); // Cross-fade between two filters using globalAlpha on two draws var fPhase = (Math.sin(Math.PI * 2 * b.filterFreq * t + b.filterPhase) + 1) * 0.5; // draw base filter ctx.save(); ctx.filter = FILTERS[b.filterBase]; ctx.globalAlpha = b.alpha * (1 - fPhase * 0.6); ctx.drawImage(img, bx, by, bw, bh, PAD + bx, PAD + by, bw, bh); ctx.restore(); // blend next filter on top ctx.save(); ctx.filter = FILTERS[b.filterNext]; ctx.globalAlpha = b.alpha * (fPhase * 0.6); ctx.drawImage(img, bx, by, bw, bh, PAD + bx, PAD + by, bw, bh); ctx.restore(); // Thin neon border ctx.save(); ctx.strokeStyle = '#00ff88'; ctx.lineWidth = 0.7; ctx.globalAlpha = 0.55 + 0.3 * fPhase; ctx.strokeRect(PAD + bx + 0.5, PAD + by + 0.5, bw - 1, bh - 1); ctx.restore(); // Store computed pos for lines b._cx = PAD + bx + bw * 0.5; b._cy = PAD + by + bh * 0.5; // Animated bezier control-point offset b._cpx = b.cpOxBase + b.cpAmpX * Math.sin(Math.PI * 2 * b.cpFreqX * t + b.cpPhaseX); b._cpy = b.cpOyBase + b.cpAmpY * Math.sin(Math.PI * 2 * b.cpFreqY * t + b.cpPhaseY); }); // Curved vibrating lines → mouse if (hovering && mouse) { var mx = PAD + mouse.x; var my = PAD + mouse.y; boxes.forEach(function (b) { var cpx = (b._cx + mx) * 0.5 + b._cpx; var cpy = (b._cy + my) * 0.5 + b._cpy; ctx.save(); ctx.strokeStyle = '#00ff88'; ctx.lineWidth = 0.55; ctx.globalAlpha = 0.45; ctx.shadowColor = '#00ff88'; ctx.shadowBlur = 6; ctx.beginPath(); ctx.moveTo(b._cx, b._cy); ctx.quadraticCurveTo(cpx, cpy, mx, my); ctx.stroke(); ctx.restore(); }); // Cursor dot ctx.save(); ctx.fillStyle = '#00ff88'; ctx.globalAlpha = 0.9; ctx.shadowColor = '#00ff88'; ctx.shadowBlur = 10; ctx.beginPath(); ctx.arc(mx, my, 2.5, 0, Math.PI * 2); ctx.fill(); ctx.restore(); } raf = requestAnimationFrame(loop); } img.addEventListener('mouseenter', function () { hovering = true; }); img.addEventListener('mouseleave', function () { hovering = false; mouse = null; }); img.addEventListener('mousemove', function (e) { var r = img.getBoundingClientRect(); mouse = { x: e.clientX - r.left, y: e.clientY - r.top }; }); window.addEventListener('resize', function () { setup(); }, { passive: true }); if (img.complete && img.naturalWidth) setup(); else img.addEventListener('load', setup); } if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initPhotoFX); else initPhotoFX(); })(); </script> </div> <footer class="fixed-bottom"> <div class="container mt-0"> &copy; Copyright 2026 Mirco Planamente. Powered by <a href="https://jekyllrb.com/" target="_blank">Jekyll</a> with <a href="https://github.com/alshedivat/al-folio">al-folio</a> theme. Hosted by <a href="https://pages.github.com/" target="_blank">GitHub Pages</a>. </div> </footer> <script src="https://cdn.jsdelivr.net/npm/jquery@3.6.0/dist/jquery.min.js" integrity="sha256-/xUj+3OJU5yExlq6GSYGSHk7tPXikynS7ogEvDej/m4=" crossorigin="anonymous"></script> <script src="/assets/js/bootstrap.bundle.min.js"></script> <script src="https://cdn.jsdelivr.net/npm/mdbootstrap@4.20.0/js/mdb.min.js" integrity="sha256-NdbiivsvWt7VYCt6hYNT3h/th9vSTL4EDWeGs5SN3DA=" crossorigin="anonymous"></script> <script defer src="https://cdn.jsdelivr.net/npm/masonry-layout@4.2.2/dist/masonry.pkgd.min.js" integrity="sha256-Nn1q/fx0H7SNLZMQ5Hw5JLaTRZp0yILA/FRexe19VdI=" crossorigin="anonymous"></script> <script defer src="https://cdn.jsdelivr.net/npm/imagesloaded@4/imagesloaded.pkgd.min.js"></script> <script defer src="/assets/js/masonry.js" type="text/javascript"></script> <script defer src="https://cdn.jsdelivr.net/npm/medium-zoom@1.0.8/dist/medium-zoom.min.js" integrity="sha256-7PhEpEWEW0XXQ0k6kQrPKwuoIomz8R8IYyuU1Qew4P8=" crossorigin="anonymous"></script> <script defer src="/assets/js/zoom.js?7b30caa5023af4af8408a472dc4e1ebb"></script> <script defer src="https://unpkg.com/bootstrap-table@1.22.1/dist/bootstrap-table.min.js"></script> <script src="/assets/js/no_defer.js?d633890033921b33e0ceb13d22340a9c"></script> <script defer src="/assets/js/common.js?acdb9690d7641b2f8d40529018c71a01"></script> <script defer src="/assets/js/copy_code.js?c9d9dd48933de3831b3ee5ec9c209cac" type="text/javascript"></script> <script async src="https://d1bxh8uas1mnw7.cloudfront.net/assets/embed.js"></script> <script async src="https://badge.dimensions.ai/badge.js"></script> <script type="text/javascript">window.MathJax={tex:{tags:"ams"}};</script> <script defer type="text/javascript" id="MathJax-script" src="https://cdn.jsdelivr.net/npm/mathjax@3.2.0/es5/tex-mml-chtml.js"></script> <script defer src="https://polyfill.io/v3/polyfill.min.js?features=es6"></script> <script type="text/javascript">function progressBarSetup(){"max"in document.createElement("progress")?(initializeProgressElement(),$(document).on("scroll",function(){progressBar.attr({value:getCurrentScrollPosition()})}),$(window).on("resize",initializeProgressElement)):(resizeProgressBar(),$(document).on("scroll",resizeProgressBar),$(window).on("resize",resizeProgressBar))}function getCurrentScrollPosition(){return $(window).scrollTop()}function initializeProgressElement(){let e=$("#navbar").outerHeight(!0);$("body").css({"padding-top":e}),$("progress-container").css({"padding-top":e}),progressBar.css({top:e}),progressBar.attr({max:getDistanceToScroll(),value:getCurrentScrollPosition()})}function getDistanceToScroll(){return $(document).height()-$(window).height()}function resizeProgressBar(){progressBar.css({width:getWidthPercentage()+"%"})}function getWidthPercentage(){return getCurrentScrollPosition()/getDistanceToScroll()*100}const progressBar=$("#progress");window.onload=function(){setTimeout(progressBarSetup,50)};</script> </body> </html>